# Copy this file to `.env` and fill in real values.
#
# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:3000        # frontend origin (CORS + CSRF allowlist)

# ─── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/travelplanner

# ─── Auth (use long random strings, 32+ chars each) ───────
JWT_ACCESS_SECRET=replace-with-a-32+character-random-string
JWT_REFRESH_SECRET=replace-with-another-32+character-random-string

# ─── LLM (OpenAI-compatible: Gemini or NVIDIA NIM) ────────
# Gemini:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-gemini-api-key
# NVIDIA NIM (alternative):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_API_KEY=your-nvidia-api-key
